# Function secrets. Set them with:  supabase secrets set --env-file supabase/functions/.env   (file is git-ignored)
# SUPABASE_URL and the secret API key are injected by Supabase automatically — do not set them.

# Exact origins of the site (scheme + host, no trailing slash), comma-separated.
ALLOWED_ORIGINS=https://example.org,https://www.example.org
# Cloudflare Turnstile SECRET key (server-side verification).
TURNSTILE_SECRET_KEY=
# Random string >= 16 chars used to hash visitor IPs for rate limiting (rotating it resets counters).
IP_HASH_SALT=
# Version label of the published privacy text; the site's VITE_CONSENT_VERSION must match exactly.
CONSENT_VERSION=

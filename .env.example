# Copy to .env.local (never commit real values). Everything here is PUBLIC by design — it ships in the browser bundle.
# Sending stays OFF (honest "preview" mode) unless ALL of these are set and ENABLED is "true".

VITE_SUBMISSION_ENABLED=false
# https://<project-ref>.supabase.co/functions/v1/submit-intake
VITE_SUBMISSION_URL=
# Cloudflare Turnstile SITE key (public). The SECRET key is a function secret, never here.
VITE_TURNSTILE_SITE_KEY=
# Must equal the function's CONSENT_VERSION; set it only when the real privacy policy is published.
VITE_CONSENT_VERSION=
# Responsible contact shown on the privacy page (email or handle), supplied by the owner.
VITE_PRIVACY_CONTACT=
# Retention period in days for reviewed/closed submissions, decided by the owner.
VITE_RETENTION_DAYS=
# Production origin, e.g. https://example.org (no trailing slash). Adds canonical, hreflang, og:url, og:image, sitemap.xml
# and the robots.txt Sitemap line at build time. Leave empty until the real domain exists.
VITE_SITE_URL=

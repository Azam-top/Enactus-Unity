{
  "name": "enactus-kaznu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "shots": "node scripts/screenshots.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:validation": "node scripts/check-validation.mjs",
    "check": "npm run typecheck && npm run check:shared && npm run check:locales && npm run check:validation && npm run test:backend",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "test:backend": "node scripts/test-backend.mjs",
    "build:mock": "tsc -b && vite build --mode mock --outDir dist-mock",
    "test:ui-mock": "node scripts/test-ui-mock.mjs",
    "audit": "node scripts/audit.mjs",
    "test:csp": "node scripts/test-csp.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
